[Unit]
Description=Atualiza o catálogo do OmaStore e avisa sobre atualizações
Documentation=https://github.com/KitsuneSemCalda/OmaStore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/omastore index
# Só notifica quando o conjunto de atualizações muda; nada é instalado.
ExecStartPost=/usr/bin/omastore update --check --notify
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
