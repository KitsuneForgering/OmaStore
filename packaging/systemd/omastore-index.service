[Unit]
Description=Refresh the OmaStore catalog and notify about updates
Documentation=https://github.com/KitsuneSemCalda/OmaStore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/omastore index
# Only notifies when the set of updates changes; nothing is installed.
ExecStartPost=/usr/bin/omastore update --check --notify
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
