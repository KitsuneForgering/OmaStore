[Unit]
Description=Refresh the OmaStore catalog and update the installed apps
Documentation=https://github.com/KitsuneForgering/OmaStore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/omastore index
# With automatic updates on (the default; omastore auto-update off), installs
# the updates that can be verified; the rest is notified once per set.
ExecStartPost=/usr/bin/omastore update --auto --notify
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
