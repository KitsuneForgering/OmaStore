[Unit]
Description=OmaStore daemon (Omarchy app indexer and installer)
Documentation=https://github.com/KitsuneForgering/OmaStore
Requires=omastored.socket
After=omastored.socket network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/omastored
Restart=on-failure
# Apps are installed into $HOME without privileges. NoNewPrivileges is left
# off on purpose: the system dependencies an app declares are installed only
# through the setuid pkexec (polkit asks for the password), which
# NoNewPrivileges=yes would refuse ("pkexec must be setuid root").

[Install]
Also=omastored.socket
