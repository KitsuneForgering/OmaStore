# Maintainer: KitsuneSemCalda <arthuramagalhaes1312@gmail.com>
# Generated by `make pkgbuild-bin VERSION=...` from PKGBUILD.in; do not edit the PKGBUILD by hand.
pkgname=omastore-bin
_pkgname=omastore
pkgver=@VERSION@
pkgrel=1
pkgdesc='App store for Omarchy: indexes GitHub apps and installs release binaries into $HOME (prebuilt binary)'
arch=('x86_64')
url='https://github.com/KitsuneForgering/OmaStore'
license=('MIT')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'qt6-svg')
optdepends=(
  'github-cli: authentication to avoid the GitHub rate limit (gh auth login)'
  'desktop-file-utils: refresh the .desktop cache after installing apps'
  'gtk-update-icon-cache: refresh the icon cache after installing apps'
  'polkit: install the system dependencies declared by apps (pkexec)'
  'qt6-translations: translated Qt dialog buttons'
)
provides=("$_pkgname")
conflicts=("$_pkgname" "$_pkgname-git")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
}
